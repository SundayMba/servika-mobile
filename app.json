{
  "expo": {
    "name": "Servika",
    "slug": "servika",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/general-sizes/servika-orange-clean-icon-1024x1024.png",
    "scheme": "servika",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.servika.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png",
        "backgroundImage": "./assets/images/adaptive-icon-background.png",
        "monochromeImage": "./assets/images/adaptive-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.servika.app",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "servika.com.ng",
              "pathPrefix": "/a/"
            },
            {
              "scheme": "https",
              "host": "www.servika.com.ng",
              "pathPrefix": "/a/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/web/favicon-32x32.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo/splash-tile.png",
          "imageWidth": 96,
          "resizeMode": "contain",
          "backgroundColor": "#F97316"
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Servika uses your location to share your live position with the customer while you travel to a job."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Servika needs photo access so you can upload your ID and profile photos.",
          "cameraPermission": "Servika needs camera access to take your verification selfie."
        }
      ],
      "expo-notifications",
      "@react-native-google-signin/google-signin",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.google.android.gms.maps.** { *; }\n-keep interface com.google.android.gms.maps.** { *; }\n-keep class com.swmansion.** { *; }\n-keep class com.reactnativecommunity.** { *; }\n-keep class expo.modules.** { *; }",
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "servika",
          "project": "servika-customer",
          "url": "https://de.sentry.io/"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Servika uses the camera to scan an artisan's QR code so you can book them.",
          "recordAudioAndroid": false
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7e7810bb-0f92-47d4-90f6-30b6f755d551"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7e7810bb-0f92-47d4-90f6-30b6f755d551",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
